# ===== Discord =====
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# ===== 権限（カンマ区切りで複数指定可） =====
# 運営ロール: 運営コマンドを実行できる
OPS_ROLE_IDS=
# ホストロール: /submit-replay を実行できる（運営ロールも実行可）
HOST_ROLE_IDS=
# 参加者ロール: エントリー完了時に自動付与
PARTICIPANT_ROLE_ID=

# ===== チャンネル =====
# 運営専用チャンネル（解析プレビュー・警告・欠場通知）
OPS_CHANNEL_ID=
# チェックインボタンを投稿するチャンネル
CHECKIN_CHANNEL_ID=
# 順位表を固定表示するチャンネル
STANDINGS_CHANNEL_ID=
# 告知チャンネル（最終結果など）
ANNOUNCE_CHANNEL_ID=
# 配信者/実況者用チャンネル（任意）
CASTER_CHANNEL_ID=

# ===== 動作設定 =====
# 大会ルールファイル
TOURNAMENT_CONFIG_PATH=config/tournament.json
# データ保存先（SQLite / リプレイファイル）
DATA_DIR=data
LOG_DIR=logs
# debug | info | warn | error
LOG_LEVEL=info
# リプレイ解析エンジン: fortnite-replay-analysis | external
REPLAY_PARSER=fortnite-replay-analysis
# REPLAY_PARSER=external の場合の実行ファイル（引数にリプレイパスを受け取りJSONを標準出力するもの）
REPLAY_PARSER_BIN=
# URL取り込み時の最大ファイルサイズ(MB)
REPLAY_MAX_SIZE_MB=500
# 同時解析数
REPLAY_CONCURRENCY=1
